# JSON service account Google (akses baca ke spreadsheet).
# Gunakan tanda kutip tunggal agar JSON multi-baris terbaca oleh dotenv.
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# ID spreadsheet (bagian URL di antara /d/ dan /edit)
GOOGLE_SHEET_ID="..."

# Opsional: nama sheet kalau berbeda dari bawaan
# SHEET_B2C="B2C CSS Tally"
# SHEET_B2B="B2B CSS Tally"

# Login admin untuk dashboard utama, export, dan halaman Share akses cabang.
# Tanpa dua nilai ini semua halaman admin terkunci (link cabang dan /presentasi tetap terbuka).
ADMIN_PASSWORD="ganti-dengan-password-kuat"
# Kunci tanda tangan sesi, minimal 16 karakter acak. Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="..."

# Opsional: nama sheet target sampling kalau berbeda dari bawaan
# SHEET_SAMPLING="Target Sampling"

# Penyimpanan link akses cabang (Upstash Redis lewat Vercel Marketplace; Vercel menamainya KV_REST_API_URL/TOKEN, keduanya didukung).
# Wajib di produksi: tanpa ini di Vercel link tidak bisa dibuat. Lokal memakai berkas .data/ otomatis.
# Kunci di Redis diberi awalan "joumpa:" jadi aman dipakai bersama proyek lain.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="ISI_TOKEN"

# Opsional: alamat publik untuk link yang dibagikan (default: domain production Vercel)
# SITE_URL="https://joumpa-css-survey.vercel.app"
