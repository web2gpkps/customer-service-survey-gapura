# JSON service account Google (akses baca ke spreadsheet).
# Gunakan tanda kutip tunggal agar JSON multi-baris terbaca oleh dotenv.
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","client_email":"...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# ID spreadsheet (bagian URL di antara /d/ dan /edit)
GOOGLE_SHEET_ID="..."

# Opsional: nama sheet kalau berbeda dari bawaan
# SHEET_B2C="B2C CSS Tally"
# SHEET_B2B="B2B CSS Tally"

# Login admin untuk dashboard utama, export, dan halaman Share akses cabang.
# Tanpa dua nilai ini semua halaman admin terkunci (link cabang dan link laporan /p/<kode> tetap terbuka selama masih berlaku).
ADMIN_PASSWORD="ganti-dengan-password-kuat"
# Kunci tanda tangan sesi, minimal 16 karakter acak. Contoh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="..."

# Opsional: nama sheet target sampling kalau berbeda dari bawaan
# SHEET_SAMPLING="Target Sampling"

# Penyimpanan link akses cabang (Upstash Redis lewat Vercel Marketplace; Vercel menamainya KV_REST_API_URL/TOKEN, keduanya didukung).
# Wajib di produksi: tanpa ini di Vercel link tidak bisa dibuat. Lokal memakai berkas .data/ otomatis.
# Kunci di Redis diberi awalan "joumpa:" jadi aman dipakai bersama proyek lain.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="ISI_TOKEN"

# Opsional: alamat publik untuk link yang dibagikan (default: domain production Vercel)
# SITE_URL="https://joumpa-css-survey.vercel.app"

# ── Menu Tindak Lanjut (/tindak-lanjut) ──
# Sheet "Tracking Follow Up Index CSS JOUMPA" (ID di URL antara /d/ dan /edit). Service account yang sama dengan di atas
# harus berstatus EDITOR di sheet ini (sheet survei tetap hanya-baca). Sheet ini satu-satunya penyimpanan data tindak lanjut.
TRACKER_SHEET_ID="..."
# Tiga tingkat akses menu. Keempat password (ADMIN_PASSWORD dashboard + tiga password menu) harus BERBEDA semua;
# password menu yang sama dengan ADMIN_PASSWORD diabaikan, jadi password dashboard tidak bisa membuka menu Tindak Lanjut.
FOLLOWUP_ADMIN_PASSWORD="ganti-dengan-password-kuat-admin-menu"
# Management boleh mengisi dan mengubah; Lihat saja hanya bisa membaca.
FOLLOWUP_MANAGER_PASSWORD="ganti-dengan-password-kuat"
FOLLOWUP_VIEWER_PASSWORD="ganti-dengan-password-kuat-lain"
# Token rahasia (minimal 24 karakter acak) untuk webhook Google Apps Script yang memicu sinkronisasi saat ada respons baru.
# Tanpa ini webhook nonaktif; sinkronisasi tetap jalan saat halaman dibuka (maksimal sekali per 60 detik).
FOLLOWUP_SYNC_TOKEN="..."

# Opsional: nama tab sheet tracker kalau berbeda dari bawaan (B2C, B2B, Rekap)
# TRACKER_TAB_B2C="B2C"
# TRACKER_TAB_B2B="B2B"
# TRACKER_TAB_REKAP="Rekap"

# Unggah evidence ke Google Drive lewat Apps Script Web App milik akun Google pemilik (bukan service account).
# Pemasangan: integrations/apps-script-evidence-upload.gs. Tanpa dua nilai ini tombol unggah menampilkan "Upload Evidence Gagal Tersimpan".
EVIDENCE_UPLOAD_URL="https://script.google.com/macros/s/.../exec"
EVIDENCE_UPLOAD_TOKEN="..."
